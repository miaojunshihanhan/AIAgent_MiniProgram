page{background:#f4f7fc;color:#17233d;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button{font-weight:400}button::after{border:none}.page-scroll{flex:1;min-height:0;overflow:hidden}.page-body{padding:34rpx 30rpx 60rpx}.page-title{font-size:38rpx;font-weight:600;line-height:1.5;word-break:break-all}.page-description{font-size:24rpx;color:#8490a4;line-height:1.8;margin-top:12rpx;margin-bottom:30rpx}.panel{background:white;border-radius:22rpx;padding:30rpx;box-sizing:border-box}.notice{font-size:24rpx;color:#8b97aa;padding:28rpx 0;text-align:center}.error-box{font-size:25rpx;background:#fff0ef;color:#b24d4d;padding:24rpx;border-radius:16rpx;margin-bottom:24rpx;line-height:1.7}.primary-button,.secondary-button{margin:24rpx 0 0;font-size:27rpx;border-radius:18rpx;line-height:86rpx}.primary-button{background:#315fe5;color:white}.secondary-button{background:#e8eefb;color:#315fe5}
.access-state{padding:80rpx 40rpx;text-align:center;color:#7b899a;font-size:26rpx;line-height:1.9}.access-state .secondary-button{max-width:360rpx;margin:28rpx auto}
.intro-announcement-row{padding:18rpx 30rpx 0;flex-shrink:0}
.announcement-overlay{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:40rpx;box-sizing:border-box}
.announcement-dialog{width:100%;max-width:620rpx;min-width:0;background:#fff;border-radius:24rpx;overflow:hidden}
.announcement-heading{padding:36rpx 30rpx 24rpx;text-align:center;font-size:32rpx;font-weight:600;color:#17233d}
.announcement-content{height:45vh;box-sizing:border-box;padding:0 32rpx 24rpx}
.announcement-paragraph{display:block;white-space:pre-wrap;word-break:break-all;line-height:1.8;font-size:28rpx;color:#65748c;background:#e7efff;padding:24rpx;box-sizing:border-box;border-radius:24rpx}
.announcement-stable{margin-bottom:28rpx}
.announcement-confirm{margin:0;border-radius:0;border-top:1rpx solid #e8edf6;background:#fff;color:#315fe5;font-size:30rpx;line-height:96rpx}
.intro-announcement-button{width:100%;height:100rpx;line-height:100rpx;box-sizing:border-box;margin:0;padding:0 24rpx;font-size:24rpx;background:#edf0f5;color:#76829a;border-radius:18rpx}
.toolbar .eyebrow{flex:1;min-width:0;font-size:16rpx;letter-spacing:1rpx;margin-right:12rpx}
.toolbar .toolbar-actions{flex-shrink:0;gap:10rpx}
.toolbar .toolbar-actions .small-button{height:58rpx;line-height:58rpx;min-width:86rpx;padding:0 18rpx;white-space:nowrap;box-sizing:border-box;font-size:24rpx}
