# Copy to backend/.env; never put secrets in mini program code.
HOST=127.0.0.1
PORT=3000
# mock = local excerpts; api = real model
MODEL_MODE=mock
# ===== Fill in model API here (Chat Completions compatible) =====
MODEL_API_URL=https://YOUR-PROVIDER.example/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=
# Compatible aliases: API_URL, API_KEY, MODEL. Prefer the MODEL_* names above.
# Runtime variables override local .env, including when using these aliases.
MODEL_TIMEOUT_MS=90000
# Qwen defaults to false for faster first text; true explicitly enables thinking.
MODEL_ENABLE_THINKING=false
MATERIALS_ROOT=./materials
DATA_ROOT=./data

# Local import/upload uses the following COS settings; never commit real credentials.
DEPLOYMENT_MODE=local
STORAGE_MODE=local
COS_BUCKET=
COS_REGION=
COS_PREFIX=knowledge-agent
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional temporary credential token
COS_SESSION_TOKEN=
# All mini program users can access the shared library; ALLOWED_OPENIDS is unused.
