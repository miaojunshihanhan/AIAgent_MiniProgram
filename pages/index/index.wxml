<navigation-bar title="广州华商学院 AI助学" back="{{false}}" color="#17233d" background="#f4f7fc"></navigation-bar>
<view class="toolbar">
  <text class="eyebrow">KNOWLEDGE ASSISTANT</text>
  <view class="toolbar-actions"><button class="small-button" bindtap="openLibrary">资料库</button><button class="small-button muted-button" bindtap="clearChat" disabled="{{sending}}" style="position: relative; left: 0rpx; top: 0rpx; width: 195rpx; display: block; box-sizing: border-box">清空</button></view>
</view>
<view class="status" bindtap="refreshHealth"><view class="status-dot {{ready ? 'online' : ''}}"></view><text>{{status}}</text></view>
<scroll-view class="chat-scroll" scroll-y type="list" scroll-into-view="{{scrollInto}}" scroll-with-animation>
  <view wx:if="{{!messages.length}}" class="welcome">
    <view class="welcome-icon">知</view><view class="welcome-title">让答案有据可查</view>
    <view class="welcome-text">围绕已导入的材料提问，回答下方可查看相关原文。</view>
    <view class="hint-card"><text>开始使用</text><text>请提问,模型会根据材料回答</text></view>
  </view>
  <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="message {{item.role}}">
    <text class="role-label">{{item.role === 'user' ? '我' : '材料助手'}}</text>
    <view class="bubble"><view wx:for="{{item.lines}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="lineIndex" class="message-line"><text class="message-text" selectable>{{line}}</text></view></view>
    <view wx:if="{{item.citations.length}}" class="sources"><text class="sources-label">本次回答依赖的材料</text>
      <view wx:for="{{item.citations}}" wx:for-item="source" wx:key="chunkId" class="source-card">
        <view class="source-title">[{{source.id}}] {{source.title}}</view><view wx:if="{{!source.metadataOnly}}" class="source-location">{{source.location}}</view>
        <view wx:if="{{source.assetLoading}}" class="source-location">正在加载原材料…</view>
        <image wx:if="{{source.assetPath}}" class="source-image" src="{{source.assetPath}}" mode="widthFix" data-source="{{source}}" data-message="{{item.id}}" bindtap="previewSourceImage" binderror="onSourceAssetError"/>
        <video wx:if="{{source.kind === 'video' && source.assetUrl}}" class="source-video" src="{{source.assetUrl}}" controls object-fit="contain" data-source="{{source}}" data-message="{{item.id}}" binderror="onSourceAssetError"/>
        <text wx:if="{{!source.metadataOnly}}" class="source-quote" selectable>{{source.pageText || source.quote}}</text>
        <view wx:if="{{source.assetError}}" class="source-asset-error">{{source.assetError}}</view>
        <button wx:if="{{source.assetError}}" class="small-button" data-source="{{source}}" data-message="{{item.id}}" bindtap="retrySourceAsset">重试加载材料</button>
        <view class="source-link" data-source="{{source}}" bindtap="openSource">打开完整原文件 →</view>
      </view>
    </view>
  </view>
  <view wx:if="{{sending}}" class="thinking"><view>{{waitingText}} · 已等待 {{elapsed}} 秒</view><view wx:if="{{elapsed >= 15}}" class="wait-note">模型仍在处理，可先浏览资料库；返回后可继续获取回答。</view><button class="small-button" bindtap="pauseWaiting">暂停等待</button></view>
  <view wx:if="{{pendingJob && !sending}}" class="thinking"><view>原回答任务已保留，无需重新提问。</view><button class="small-button" bindtap="resumeAnswer">继续获取回答</button><button class="small-button muted-button" bindtap="discardPending">放弃获取，开始新问题</button></view>
  <view class="scroll-bottom"></view>
</scroll-view>
<view class="composer"><view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <view class="input-row"><textarea class="question-input" value="{{input}}" bindinput="onInput" placeholder="输入与材料有关的问题…" maxlength="2000" auto-height show-confirm-bar="{{false}}"/><button class="send-button" bindtap="send" loading="{{sending}}" disabled="{{sending || pendingJob || !input}}">发送</button></view>
  <view class="composer-note">支持多轮追问 · 最近对话随提问发送给模型 · 来源直接展示</view>
</view>
