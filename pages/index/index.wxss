page{height:100vh;display:flex;flex-direction:column;background:#f4f7fc;color:#17233d}
.toolbar{padding:24rpx 32rpx 12rpx;display:flex;align-items:center;justify-content:space-between}.eyebrow{font-size:18rpx;letter-spacing:2rpx;color:#78859b}.toolbar-actions{display:flex;gap:12rpx}.small-button{margin:0;padding:0 22rpx;line-height:58rpx;font-size:24rpx;background:#e7efff;color:#315fe5;border-radius:18rpx}.small-button::after,.send-button::after{border:none}.muted-button{color:#76829a;background:#edf0f5}
.status{padding:8rpx 32rpx 20rpx;display:flex;align-items:center;gap:12rpx;font-size:22rpx;color:#738199}.status-dot{width:12rpx;height:12rpx;background:#d39a59;border-radius:50%;flex-shrink:0}.status-dot.online{background:#2caa87}.chat-scroll{flex:1;min-height:0;overflow:hidden}.welcome{padding:52rpx 36rpx}.welcome-icon{width:88rpx;height:88rpx;border-radius:28rpx;background:#315fe5;color:white;display:flex;justify-content:center;align-items:center;font-size:42rpx}.welcome-title{font-size:44rpx;font-weight:600;margin-top:28rpx}.welcome-text{font-size:27rpx;color:#75829a;line-height:1.8;margin-top:18rpx}.hint-card{display:flex;flex-direction:column;gap:18rpx;background:white;padding:30rpx;border-radius:24rpx;margin-top:36rpx;font-size:24rpx;color:#65748e}.message{width:calc(100% - 60rpx);min-width:0;box-sizing:border-box;margin:24rpx 30rpx;display:flex;flex-direction:column;align-items:flex-start}.message.user{align-items:flex-end}.role-label{font-size:22rpx;color:#8490a3;margin-bottom:10rpx}.bubble{width:94%;max-width:94%;min-width:0;box-sizing:border-box;padding:24rpx 28rpx;border-radius:22rpx;background:#fff;font-size:28rpx;line-height:1.85;white-space:pre-wrap;word-break:break-all}.user .bubble{background:#315fe5;color:white}.sources{width:100%;margin-top:22rpx}.sources-label{font-size:22rpx;color:#7a879c}.source-card{padding:24rpx;margin-top:14rpx;border:1rpx solid #dfe6f2;border-radius:18rpx;background:white}.source-title{font-size:25rpx;font-weight:600;word-break:break-all}.source-location{font-size:22rpx;color:#8994a7;margin-top:8rpx}.source-quote{font-size:23rpx;color:#65748c;line-height:1.6;max-height:112rpx;overflow:hidden;margin-top:12rpx;white-space:pre-wrap}.source-link{font-size:23rpx;color:#315fe5;margin-top:16rpx}.thinking{padding:22rpx 32rpx;color:#7b89a1;font-size:24rpx}.scroll-bottom{height:28rpx}.composer{padding:18rpx 26rpx 24rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8edf6}.input-row{display:flex;align-items:flex-end;gap:16rpx}.question-input{box-sizing:border-box;flex:1;width:0;min-height:80rpx;max-height:220rpx;padding:22rpx;font-size:27rpx;border-radius:20rpx;background:#f3f6fb}.send-button{margin:0;background:#315fe5;color:#fff;line-height:82rpx;padding:0 28rpx;font-size:26rpx;border-radius:20rpx}.send-button[disabled]{background:#ccd6ef;color:white}.composer-note{text-align:center;font-size:19rpx;color:#9aa4b6;margin-top:16rpx}.error-banner{font-size:24rpx;color:#b64a4a;background:#fff1f0;padding:18rpx;border-radius:12rpx;margin-bottom:16rpx}

/* Explicit flex bases override native textarea/button default sizing. */
.input-row{width:100%;display:flex;align-items:flex-end;gap:16rpx}.question-input{flex:1 1 0%;width:0;min-width:0;max-width:none}.send-button{flex:0 0 112rpx;width:112rpx;min-width:112rpx;max-width:112rpx;padding:0;box-sizing:border-box;margin:0}

/* Bound native text width, including long links and unbroken model output. */
.message-line{width:100%;min-width:0;max-width:100%;box-sizing:border-box}
.message-text{display:block;width:100%;max-width:100%;min-width:0;box-sizing:border-box;white-space:pre-wrap;word-break:break-all;overflow-wrap:anywhere}
.source-card{box-sizing:border-box;min-width:0;max-width:100%}
.source-quote{display:block;max-height:none;overflow:visible;overflow-wrap:anywhere;word-break:break-all}.source-image{display:block;width:100%;margin-top:16rpx}.source-video{display:block;width:100%;height:380rpx;margin-top:16rpx}.source-asset-error{font-size:23rpx;color:#b64a4a;margin:12rpx 0}
