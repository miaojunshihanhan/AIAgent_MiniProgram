page{height:100%;display:flex;flex-direction:column}.information-scroll{flex:1;min-height:0}.page-body{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.page-title{font-size:38rpx}.content-title{font-size:29rpx;font-weight:600;line-height:1.6}.paragraph{display:block;font-size:27rpx;line-height:1.95;margin-top:20rpx;color:#526075;word-break:break-all}.content-panel{margin-top:24rpx}.spaced-title{margin-top:32rpx}.reading-section+.reading-section{margin-top:36rpx;padding-top:28rpx;border-top:1rpx solid #edf1f5}.step-label{font-size:23rpx;color:#39826e;font-weight:600}.primary-button{background:#286452}.progress-heading{display:flex;justify-content:space-between;font-size:26rpx;margin-bottom:26rpx}.completed-note{margin-top:22rpx;font-size:24rpx;line-height:1.8;color:#286452}.check-row{display:flex;align-items:center;gap:16rpx;padding:23rpx 0;font-size:26rpx;line-height:1.7}.check-row+.check-row{border-top:1rpx solid #edf1f5}.check-row text{flex:1}.faq-card{margin-top:20rpx}.faq-question{display:flex;justify-content:space-between;gap:24rpx;text-align:left;padding:0;margin:0;line-height:1.7;font-size:28rpx;background:#fff;color:#17233d}.faq-answer{border-top:1rpx solid #edf1f5;padding-top:20rpx}.home-button{margin:32rpx 0 0;background:transparent;font-size:25rpx;line-height:80rpx;color:#607287}
