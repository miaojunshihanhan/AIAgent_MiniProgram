page{height:100%;display:flex;flex-direction:column}.intro-scroll{flex:1;min-height:0}.intro-body{padding:24rpx 30rpx calc(48rpx + env(safe-area-inset-bottom))}.hero{position:relative;overflow:hidden;background:#163a49;color:#fff;padding:42rpx 34rpx;border-radius:28rpx}.hero-label{font-size:18rpx;letter-spacing:3rpx;color:#acd9d5}.hero-title{position:relative;z-index:1;font-size:44rpx;line-height:1.5;font-weight:600;margin-top:26rpx;max-width:490rpx}.hero-description{position:relative;z-index:1;font-size:25rpx;line-height:1.9;color:#d0e1e5;margin-top:20rpx}.hero-button{position:relative;z-index:1;margin:30rpx 0 0;width:310rpx;background:#d4efe2;color:#163a49;border-radius:14rpx;font-size:25rpx;line-height:78rpx}.hero-mark{position:absolute;right:-16rpx;top:10rpx;font-size:240rpx;color:#28505b;transform:rotate(-12deg)}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:40rpx 0 22rpx}.section-title{font-size:31rpx;font-weight:600}.section-note{font-size:22rpx;color:#7b899a}.quick-grid{display:flex;gap:20rpx}.quick-card{flex:1;min-width:0;margin:0;padding:26rpx;background:#fff;border-radius:20rpx;text-align:left;line-height:1.6}.quick-icon{width:48rpx;height:48rpx;text-align:center;line-height:48rpx;border-radius:12rpx;background:#e6f2ed;color:#286452;font-size:29rpx}.quick-title{font-size:28rpx;font-weight:600;margin-top:14rpx}.quick-caption{font-size:22rpx;color:#7b899a;margin-top:4rpx}.search-input{background:#e9eef4;border-radius:16rpx;height:84rpx;padding:0 24rpx;font-size:25rpx;box-sizing:border-box;margin-bottom:22rpx}.topic-card{background:#fff;border-radius:20rpx;padding:28rpx;margin:0 0 18rpx;text-align:left;line-height:1.6}.topic-number{font-size:22rpx;font-weight:600;color:#39826e}.topic-title{font-size:29rpx;font-weight:600;margin-top:8rpx}.topic-summary{font-size:24rpx;color:#7b899a;line-height:1.8;margin-top:10rpx}.topic-link{font-size:23rpx;color:#286452;margin-top:18rpx}.contact-entry{display:flex;justify-content:space-between;background:#e5edea;border-radius:16rpx;padding:26rpx;margin:28rpx 0 0;text-align:left;line-height:1.6;font-size:24rpx;color:#285545}.contact-entry text:last-child{font-size:22rpx}.intro-footer{font-size:21rpx;color:#8b97aa;text-align:center;margin-top:32rpx}
