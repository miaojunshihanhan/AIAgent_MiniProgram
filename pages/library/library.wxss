page{height:100vh;display:flex;flex-direction:column}.document-card{margin-bottom:22rpx}.document-type{display:inline-block;padding:8rpx 15rpx;border-radius:10rpx;background:#eaf0ff;color:#315fe5;font-size:20rpx;text-transform:uppercase}.document-name{font-size:31rpx;font-weight:600;margin-top:18rpx;word-break:break-all}.document-meta,.document-version{font-size:23rpx;color:#8994a7;margin-top:12rpx}.document-link{font-size:25rpx;color:#315fe5;margin-top:24rpx}.empty{font-size:30rpx;line-height:1.8}.empty text{display:block;font-size:25rpx;color:#8290a6;margin-top:18rpx}
