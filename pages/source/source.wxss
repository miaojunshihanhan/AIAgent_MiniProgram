page{height:100vh;display:flex;flex-direction:column}.evidence-panel{border-left:6rpx solid #315fe5}.section-title{font-size:28rpx;font-weight:600;margin-bottom:20rpx}.location{font-size:23rpx;color:#8290a6;margin-bottom:20rpx}.original-text{font-size:28rpx;line-height:1.9;white-space:pre-wrap;word-break:break-all}.full-text{margin-top:24rpx;padding:24rpx 12rpx}.text-line{display:flex;padding:8rpx 6rpx;min-height:32rpx}.line-number{width:64rpx;flex-shrink:0;text-align:center;color:#a0aabd;font-size:21rpx;line-height:1.9}.line-content{flex:1;min-width:0;font-size:26rpx;line-height:1.8;white-space:pre-wrap;word-break:break-all}.highlight{background:#eef3ff;border-radius:6rpx}

/* WebView scroll-view requires a definite flex height on physical devices. */
.page-scroll{height:0;flex:1;width:100%;min-height:0}
.page-body{width:100%;box-sizing:border-box}
.material-image{display:block;width:100%;max-width:100%;background:#fff}
.image-preview,.slide-panel{width:100%;min-width:0;box-sizing:border-box}

/* Keep controls and following content stationary throughout every slide request. */
.slide-stage{position:relative;width:100%;height:360rpx;overflow:hidden;background:#f3f6fb;border-radius:12rpx}
.slide-stage-image{position:absolute;left:0;top:0;width:100%;height:100%;background:transparent}
.slide-stage-loading{position:absolute;left:0;top:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#8b97aa}
.slide-stage-fallback{position:absolute;left:0;top:0;width:100%;height:100%;box-sizing:border-box;padding:16rpx}
